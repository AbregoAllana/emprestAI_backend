# ============================================================
# emprestAI — exemplo de variáveis de ambiente
# (referência: ADR-001 — Stack)
#
# Como usar:
#   - Local: copie este arquivo para .env e preencha os valores.
#   - Front/API na Vercel: setar nas Project Settings > Environment
#     Variables (uma vez por ambiente: Development/Preview/Production).
#   - CI (GitHub Actions): setar como repository secrets.
#
# NUNCA commitar .env (ver .gitignore). A service_role e as
# senhas do banco são segredos: vivem fora do repositório.
# ============================================================

# ------------------------------------------------------------
# FRONTEND (repositório do front · Vite · deploy na Vercel)
# Prefixo VITE_ é obrigatório para a variável ser exposta no bundle.
# Aqui NUNCA entram service_role, senha de banco ou JWT secret.
# ------------------------------------------------------------

# URL do projeto Supabase
# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" do Supabase (única que pode ir no front)
# Supabase > Project Settings > API > API Keys > anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...  # preencha com a anon public

# ------------------------------------------------------------
# API (repositório da API · NestJS · deploy na Vercel)
# ------------------------------------------------------------

# URL do projeto Supabase — usada para validar o JWT via JWKS
# e para chamadas ao Supabase Auth
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" do Supabase — IGNORA RLS. Somente na API,
# nunca no bundle do front (ADR-001). Vai passar a viver como
# environment variable na Vercel e como secret no GitHub Actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # preencha com a service_role

# Segredo do JWT do Supabase — usado pela API para validar a
# assinatura dos tokens emitidos pelo Supabase Auth
# Supabase > Project Settings > API > JWT Settings > JWT Secret
#
# Observação: se a validação for feita só pelo JWKS endpoint
# (SUPABASE_URL/auth/v1/.well-known/jwks.json), esta variável
# não é necessária — o ADR-001 adota JWKS.
SUPABASE_JWT_SECRET=

# Senha do banco — usada só para montar as connection strings
# abaixo. Prefira guardá-la no gerenciador de senhas.
# Supabase > Project Settings > Database > Reset database password
SUPABASE_PASSWORD=

# Connection string de RUNTIME — POOLER do Supavisor, porta 6543.
# Obrigatório manter ?pgbouncer=true&connection_limit=1 em
# serverless (ADR-001): a Vercel escala instâncias em paralelo.
# Supabase > Project Settings > Database > Connection string >
# Transaction pooler (Supavisor)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Connection string de MIGRATION — conexão direta, porta 5432.
# Usada pelo `prisma migrate deploy` e pelo seed. Nunca passa
# pelo pooler (pooler não suporta comandos de migration).
# Supabase > Project Settings > Database > Connection string >
# Direct connection
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SUA_SENHA@db.SEU-PROJETO.supabase.com:5432/postgres

# ------------------------------------------------------------
# HOSPEDAGEM (Vercel)
# Vêm do painel da Vercel, NÃO do Supabase. São usadas pelo
# GitHub Actions para rodar deploy na Vercel (front e API são
# repositórios separados, cada um com seu projeto Vercel).
# ------------------------------------------------------------

# Token de acesso da conta Vercel.
# Vercel Dashboard > Account Settings (avatar canto superior
# direito) > Tokens > Create Token. Trate como segredo.
VERCEL_TOKEN=

# ID da organização e do projeto Vercel.
# O jeito mais garantido de pegar: rodar `vercel link` na pasta
# do projeto e ler o arquivo .vercel/project.json gerado.
# (Também dá pra ver no quadro "Overview" do projeto na Vercel.)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ------------------------------------------------------------
# CI (GitHub Actions do repositório da API)
# Job que roda `prisma migrate deploy` antes do deploy na Vercel.
# ------------------------------------------------------------
# DATABASE_URL, DIRECT_URL e as VERCEL_* acima, setadas como
# secrets do GitHub. Front e API são repositórios separados
# (ADR-001), então cada um tem seu próprio projeto Vercel e
# suas próprias env vars.