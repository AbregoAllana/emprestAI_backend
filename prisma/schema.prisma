generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  COLLABORATOR
  OPERATIONS

  @@map("membership_role")
}

enum EquipmentCategory {
  NOTEBOOK
  MONITOR
  CABLE
  CAMERA
  ACCESSORY

  @@map("equipment_category")
}

enum EquipmentCondition {
  AVAILABLE
  MAINTENANCE

  @@map("equipment_condition")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(80)
  name        String       @db.VarChar(160)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  equipment   Equipment[]
  loans       Loan[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model Membership {
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Equipment {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  name        String             @db.VarChar(160)
  category    EquipmentCategory
  assetTag    String?            @map("asset_tag") @db.VarChar(80)
  notes       String?
  condition   EquipmentCondition @default(AVAILABLE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  loans       Loan[]

  @@unique([tenantId, id])
  @@index([tenantId, condition])
  @@index([tenantId, createdAt, id])
  @@map("equipment")
}

model Loan {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  equipmentId      String    @map("equipment_id") @db.Uuid
  borrowerUserId   String    @map("borrower_user_id") @db.Uuid
  borrowedAt       DateTime  @default(now()) @map("borrowed_at") @db.Timestamptz(6)
  dueAt            DateTime  @map("due_at") @db.Timestamptz(6)
  returnedAt       DateTime? @map("returned_at") @db.Timestamptz(6)
  returnedByUserId String?   @map("returned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment        Equipment @relation(fields: [tenantId, equipmentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, borrowerUserId, createdAt, id])
  @@index([tenantId, dueAt])
  @@map("loans")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(80)
  resourceType  String   @map("resource_type") @db.VarChar(80)
  resourceId    String   @map("resource_id") @db.Uuid
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  @@map("audit_logs")
}

model RateLimitBucket {
  id               String   @id @default(uuid()) @db.Uuid
  subjectType      String   @map("subject_type") @db.VarChar(10)
  subjectKey       String   @map("subject_key") @db.VarChar(255)
  routeKey         String   @map("route_key") @db.VarChar(120)
  windowStartedAt  DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount     Int      @default(0) @map("request_count")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectKey, routeKey, windowStartedAt])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
